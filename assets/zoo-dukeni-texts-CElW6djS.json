!","words":[16,17]},{"kk":"Сау бол!","ru":"До свидания!","words":[16,18]},{"kk":"Маған мысыққа жем керек.","ru":"Мне нужен корм для кота.","words":[19,20,13,4]},{"kk":"Мысық үлкен бе, кішкентай ма?","ru":"Какой кот — большой или маленький?","words":[21,22,1,23,24]},{"kk":"Маған балық керек.","ru":"Мне нужны рыбки.","words":[19,25,4]},{"kk":"Аквариумдар ана жақта.","ru":"Аквариумы вон там.","words":[7,8,9]},{"kk":"Бұл көршіге.","ru":"Это для соседки.","words":[26,27]},{"kk":"Оған қоңырау шал, сұра.","ru":"Позвони ей, спроси.","words":[28,29,30,31]},{"kk":"Қарап шығайын.","ru":"Я посмотрю.","words":[32,33]},{"kk":"Қара.","ru":"Смотри.","words":[34]},{"kk":"Үлкен, жирен.","ru":"Большой, рыжий.","words":[22,35]},{"kk":"Құрғақ жем бе, ылғалды ма?","ru":"Сухой или мокрый корм?","words":[36,13,1,37,24]},{"kk":"Білмеймін, көршіден сұраймын.","ru":"Не знаю, спрошу соседку.","words":[38,39,40]},{"kk":"Оған қоңырау шал.","ru":"Позвони ей.","words":[28,29,30]},{"kk":"Балыққа жем бар ма?","ru":"А корм для рыбок есть?","words":[41,13,12,24]},{"kk":"Бар, аквариумдар жағында.","ru":"Есть, у аквариумов.","words":[12,7,42]},{"kk":"Күте тұрыңызшы.","ru":"Подождите, пожалуйста.","words":[43,44]},{"kk":"Жарайды.","ru":"Хорошо.","words":[45]},{"kk":"Қандай жем керек?","ru":"Какой корм нужен?","words":[46,13,4]},{"kk":"Құрғақ, бір қап.","ru":"Сухой, один пакет.","words":[36,47,48]},{"kk":"Мысығыңыз үлкен бе?","ru":"Ваш кот большой?","words":[49,22,1]},{"kk":"Иә, үлкен, жирен.","ru":"Да, большой, рыжий.","words":[50,22,35]},{"kk":"Неше қап?","ru":"Сколько пакетов?","words":[51,48]},{"kk":"Бір қап.","ru":"Один пакет.","words":[47,48]},{"kk":"Рақмет!","ru":"Спасибо!","words":[52]},{"kk":"Саған рақмет!","ru":"Спасибо тебе!","words":[53,52]},{"kk":"Мынау ма?","ru":"Вот этот?","words":[54,24]},{"kk":"Балыққа жем ше?","ru":"А корм для рыбок?","words":[41,13,55]},{"kk":"Ол аквариумдар жағында.","ru":"Он у аквариумов.","words":[56,7,42]},{"kk":"Қайсысы жақсы? Көршіден сұраймын.","ru":"Какой лучше?