ая?","words":[28,18,12]},{"kk":"Асхана жақын.","ru":"Столовая близко.","words":[28,29]},{"kk":"Апай, қалам беріңізші.","ru":"Учительница, дайте, пожалуйста, ручку.","words":[17,30,31]},{"kk":"Міне, ал!","ru":"Вот, возьми!","words":[19,32]},{"kk":"Қаламың бар ма?","ru":"У тебя есть ручка?","words":[33,34,9]},{"kk":"Иә, міне.","ru":"Да, вот.","words":[35,19]},{"kk":"Қалам керек, апай.","ru":"Нужна ручка, учительница.","words":[30,26,17]},{"kk":"Апай, мен мұндамын.","ru":"Учительница, я здесь.","words":[17,20,36]},{"kk":"Мынау не?","ru":"Что это?","words":[37,27]},{"kk":"Мынау қалам, апай.","ru":"Это ручка, учительница.","words":[37,30,17]},{"kk":"Дұрыс! Жарайсың!","ru":"Правильно! Молодец!","words":[38,39]},{"kk":"Мынау дәптер ме?","ru":"Это тетрадь?","words":[40,41,42]},{"kk":"Жоқ, бұл кітап.","ru":"Нет, это книга.","words":[43,44,45]},{"kk":"Қайда барасың?","ru":"Куда идёшь?","words":[18,46]},{"kk":"Апай, кейін келемін.","ru":"Апай, я приду потом.","words":[6,47,48]},{"kk":"Жарайды, тез кел.","ru":"Ладно, быстро возвращайся.","words":[49,50,51]},{"kk":"Кейін ойнайық, досым.","ru":"Потом поиграем, друг.","words":[47,52,12]},{"kk":"Жарайды, кейін ойнаймыз.","ru":"Ладно, поиграем потом.","words":[53,47,54]},{"kk":"Апай, жауап дұрыс па?","ru":"Учительница, ответ правильный?","words":[17,55,38,56]},{"kk":"Сұрақты тағы беріңізші.","ru":"Задайте вопрос ещё раз, пожалуйста.","words":[57,58,31]},{"kk":"Отыруға бола ма?","ru":"Можно сесть?","words":[59,60,9]},{"kk":"Иә, отыр!","ru":"Да, садись!","words":[35,61]},{"kk":"Рақмет, апай!","ru":"Спасибо, учительница!","words":[62,17]},{"kk":"Жарайды.","ru":"Хорошо.","words":[53]},{"kk":"Иә, дұрыс! Жарайсың!","ru":"Да, правильно! Молодец!","words":[35,38,63]},{"kk":"Апай, тағы сұрақ беріңізші.","ru":"Учительница, задайте ещё вопрос, пожалуйста.","words":[17,58,64,31]},{"kk":"Жарайды!","ru":"Ладно!","words":[65]},{"kk":"Тақтаға шығайын ба?","ru":"Мне выйти к доске?","words":[66,67,68]},{"kk":"Иә, шық, жаз.","ru":"Да, выходи, пиши.","