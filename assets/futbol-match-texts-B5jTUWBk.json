іне, осы қатар.","ru":"Вот этот ряд.","words":[2,36,37]},{"kk":"Әке, билетті маған беріңізші.","ru":"Папа, дайте мне, пожалуйста, билет.","words":[6,38,39,40]},{"kk":"Міне, ал, жоғалтпа.","ru":"Вот, возьми, не потеряй.","words":[2,41,42]},{"kk":"Әке, билетті сақтайын.","ru":"Папа, я сохраню билет.","words":[6,38,43]},{"kk":"Жарайды, сақта.","ru":"Хорошо, сохрани.","words":[23,44]},{"kk":"Әке, билет қанша тұрады?","ru":"Папа, сколько стоит билет?","words":[6,3,45,46]},{"kk":"Жеті мың бес жүз теңге.","ru":"Семь тысяч пятьсот тенге.","words":[47,48,49,50,51]},{"kk":"Кешіріңіз, бұл біздің орын.","ru":"Извините, это наше место.","words":[28,52,11,12]},{"kk":"Кешір, балам. Отыр.","ru":"Извини, сынок. Садись.","words":[53,16,24]},{"kk":"Иә, міне, билет.","ru":"Да, вот билет.","words":[9,2,3]},{"kk":"Жарайды, міне, орын.","ru":"Хорошо, вот место.","words":[23,2,12]},{"kk":"Көп рақмет сізге!","ru":"Большое вам спасибо!","words":[54,4,55]},{"kk":"Оқасы жоқ, балам.","ru":"Не за что, сынок.","words":[56,31,16]},{"kk":"Мен де су ішейін.","ru":"Я тоже попью воды.","words":[57,58,25,59]},{"kk":"Иә, іш, балам.","ru":"Да, пей, сынок.","words":[9,60,16]},{"kk":"Әке, біздің команда жақсы!","ru":"Папа, наша команда хорошая!","words":[6,11,20,61]},{"kk":"Иә, жақсы ойнайды!","ru":"Да, хорошо играет!","words":[9,61,19]},{"kk":"Су үйден. Міне, алыңыз.","ru":"Вода из дома. Вот, возьмите.","words":[25,62,2,63]},{"kk":"Әке, су керек пе?","ru":"Папа, нужна вода?","words":[6,64,65,66]},{"kk":"Жоқ, рақмет, балам.","ru":"Нет, спасибо, сынок.","words":[31,4,16]},{"kk":"Әке, доп қайда?","ru":"Папа, где мяч?","words":[6,67,13]},{"kk":"Міне, доп! Қара!","ru":"Вот мяч! Смотри!","words":[2,67,68]},{"kk":"Әке, анау ойыншы кім?","ru":"Папа, кто тот игрок?","words":[6,69,70,18]},{"kk":"Ол жақсы ойыншы.","ru":"Он хороший игрок.","words":[71,61,70]},{"kk":"Әке, біз жеңеміз бе?","ru":"Папа, мы победим?","words":[6,33,72,1]},{"kk":"Иә, жеңеміз, балам!","ru":"Да, победим, сынок!","words":[9,72,16]},{"kk":"Гол! Біз жеңеміз!","ru":"Гол! Мы победим!","words":[73,33,72]},{"kk":"Әке, керемет гол!","ru":"Папа, отличный гол!","words":[6,74,73]},{"kk":"Иә, керемет, балам!","ru":"Да, отличный, сынок!","words":[9,74,16]},{"kk":"Алақай! Тағы гол керек!","ru":"Ура! Нужен ещё гол!","words":[75,76,73,65]},{"kk":"Иә, тағы бір гол!","ru":"Да, ещё один гол!","words":[9,76,77,73]},{"kk":"Алақай, гол! Алға, команда!","ru":"Ура, гол! Вперёд, команда!","words":[75,73,78,20]},{"kk":"Алақай! Тамаша гол!","ru":"Ура! Отличный гол!","words":[75,79,73]},{"kk":"Біздің команда жеңеді!","ru":"Наша команда победит!","words":[11,20,80]},{"kk":"Иә, жеңеді, балам!","ru":"Да, победит, сынок!","words":[9,80,16]},{"kk":"Алға, біздің команда!","ru":"Вперёд, наша команда!","words":[78,11,20]},{"kk":"Жарайды! Алға, команда!","ru":"Давай! Вперёд, команда!","words":[23,78,20]},{"kk":"Мен де жанкүйермін!","ru":"Я тоже болельщик!","words":[57,58,81]},{"kk":"Жарайсың, балам!","ru":"Молодец, сынок!","words":[82,16]},{"kk":"Әке, біздің команда жақсы.","ru":"Папа, наша команда хорошая.","words":[6,11,20,61]},{"kk":"Иә, балам. Жақсы ойнайды.","ru":"Да, сынок. Хорошо играют.","words":[9,16,61,19]},{"kk":"Әке, рақмет! Керемет болды!","ru":"Папа, спасибо! Было здорово!","words":[6,4,74,83]},{"kk":"Оқасы жоқ, балам!","ru":"Не за что, сынок!","words":[56,31,16]},{"kk":"Әке, матч бітті ме?","ru":"Папа, матч закончился?","words":[6,84,85,86]},{"kk":"Иә, бітті. Үйге барайық.","ru":"Да, закончился. Поедем домой.","words":[9,85,87,88]},{"kk":"Әке, мен шаршадым.","ru":"Папа, я устал.","words":[6,57,89]},{"kk":"Жарайды, үйге барамыз.","ru":"Хорошо, едем домой.","words":[23,87,90]},{"kk":"Алға, команда!","ru":"Вперёд, команда!","words":[78,20]}],"morphemes":[{"id":"greeting-healthy","meaningRu":"здоровый (в формуле приветствия)"},{"id":"predicative-2sg-polite","meaningRu":"Вы есть (вежливое обращение)","shortRu":"вы (вежливо)"},{"id":"question","meaningRu":"Вопросительная частица","shortRu":"вопросительная частица"},{"id":"here-is"